// SEGUNDA SESIÓN · CURSO DE SALUD COMUNITARIA BASADA EN ACTIVOS · 26/10/2026
// REGLA ADITIVA: integrar DENTRO del match /databases/{database}/documents
// en el proyecto aula-salud-comunitaria. NO sustituir las reglas existentes
// de Fuente Vaqueros, Compás ni otros módulos.
//
// Ruta de colección:
// cursos/salud-comunitaria-activos-2026/sesion2_entregas
//
// Usuarios anónimos: solo CREATE conforme al esquema.
// No se permite lectura, listado, modificación ni borrado desde la web.
// El personal autorizado puede ver las entregas mediante Firebase Console
// según los permisos IAM de su cuenta (no equivalen a permisos públicos).

match /cursos/salud-comunitaria-activos-2026/sesion2_entregas/{entregaId} {
  function cursoTexto(field, maxSize) {
    return request.resource.data[field] is string
      && request.resource.data[field].size() <= maxSize;
  }
  function grupoValido(d) {
    return d.grupoNumero is int && d.grupoId is string
      && (
        (d.grupoNumero == 1 && d.grupoId == 'mapeo') ||
        (d.grupoNumero == 2 && d.grupoId == 'registro') ||
        (d.grupoNumero == 3 && d.grupoId == 'recomendacion') ||
        (d.grupoNumero == 4 && d.grupoId == 'clinica') ||
        (d.grupoNumero == 5 && d.grupoId == 'asociaciones')
      );
  }
  function entregaValida() {
    let d = request.resource.data;
    return d.keys().hasOnly([
      'grupoNumero','grupoId','respuestas','criterios','propuesta',
      'exposicion','pregunta','curso','sesion','origen','createdAt'
    ])
    && d.keys().hasAll([
      'grupoNumero','grupoId','respuestas','criterios','propuesta',
      'exposicion','pregunta','curso','sesion','origen','createdAt'
    ])
    && grupoValido(d)
    && d.curso == 'salud-comunitaria-activos-2026'
    && d.sesion == '2026-10-26'
    && d.origen == 'qr-aula'
    && d.createdAt == request.time
    && cursoTexto('respuestas', 10000) && d.respuestas.size() > 0
    && cursoTexto('criterios', 6000)
    && cursoTexto('propuesta', 6000)
    && cursoTexto('exposicion', 7000) && d.exposicion.size() > 0
    && cursoTexto('pregunta', 1500);
  }
  allow create: if request.auth != null
    && request.auth.token.firebase.sign_in_provider == 'anonymous'
    && entregaValida();
  allow get, list, update, delete: if false;
}
